# vince_defconfig
# vince (MSM8953): copied from nabu_defconfig template; UFS/DWC3 switches disabled
# because vince hardware is eMMC + no DWC3 (see TODOs below).
# Mirrors UniXNU-uke's uke-full_defconfig -- the configuration that mounts a root volume and
# starts launchd on SM7675. Every switch below is reproducible from the pinned sources alone.
#
# The hardware-qualification gates are deliberately absent, for the reasons uke records and this
# port rediscovered the hard way: VIRTIO_BLOCK / RAM_BLOCK need a live guest snapshot
# (gdb-stop.json) of the original IOBlockStorageDevice metadata; VERIFIED_ROOT_PROBE /
# OWNER_ROOT_AUDIT / OWNER_ROOT_TRUST need a signed policy bundle built from the real OS/SystemOS
# DMGs; BOOT_PROGRESS refuses to build without all of those. Enabling them mid-bring-up produces a
# chain of gates that a cold build cannot satisfy.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# Parked: NativeUfsBlock derives from IOBlockStorageDevice, which lives in the IOStorageFamily
# kext. Its symbols must come from the verified-root bundle, and no archive in this tree builds
# that bundle (it needs the target image's volume policies). Linking the reference object in
# their place registers a duplicate class and the kernel panics, so the switch stays off until
# the bundle exists.
# TODO(vince): vince storage is eMMC (driver lives in the ios-vince patch set as
# vince_mmc, patches 0091/0094) -- the UniXNU NativeUfs archive has no eMMC support yet.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NABU_UFS_REGISTER_PROBE=y
# register-probe mode: NativeUfs never compiles the IOBlockStorageDevice subclass,
# so the kernel link does not need IOStorageFamily symbols.
# vince: eMMC board; serial_general.c boot-progress log links against
# native_ufs_log_* and the --unverified probe transport never touches hardware.
# Stage-1 USB: map usb0 (0x0a600000) and read GSNPSID to prove the block
# is clocked. No endpoints or gadget yet.
# TODO(vince): MSM8953 has no DWC3 controller; USB bring-up will use the adreno-era
# qcom HSIC/CI path from the ios-vince patch set instead (patch 0072-0077).
# CONFIG_XNU_NATIVE_DWC3=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# CONFIG_XNU_NATIVE_PAN is not set
# vince: A53 (ARMv8-A) has no PAN/MPAM/CPU_CFG (Apple ACC registers);
# enabling it compiles Apple-only msr/mrs into copyio and arm_init, which
# are UNDEFINED on MSM8953 (verified under QEMU: 24 Apple msr + 14 MPAM mrs).
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="BEC2158A-350E-4F2E-B87E-A0E69FB0BDEA"

# sheng / uke specific, not carried over:
#   CONFIG_XNU_SHENG_PMGR                needs the target board's PMGR values
#   CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE  a probe for a symptom vince has not shown
#   CONFIG_XNU_NATIVE_LEGACY_DISPLAY     needs display configuration this port has not done
#   CONFIG_XNU_NATIVE_ADRENO             the driver knows Adreno 740; vince is 640

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

